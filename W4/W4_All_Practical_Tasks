# W4D6: Responsible AI - AIF360 fairness and Reweighing

import numpy as np
import pandas as pd

from aif360.datasets import AdultDataset
from aif360.metrics import BinaryLabelDatasetMetric, ClassificationMetric
from aif360.algorithms.preprocessing import Reweighing
from sklearn.linear_model import LogisticRegression
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.metrics import accuracy_score

# Load the Adult Income dataset.
# Label 1 represents income > $50K in the standard AIF360 dataset.
dataset = AdultDataset(
    protected_attribute_names=["sex"],
    privileged_classes=[["Male"]]
)

# Create train/test datasets
train, test = dataset.split([0.8], shuffle=True)

# Identify privileged and unprivileged groups
privileged_groups = [{"sex": 1.0}]
unprivileged_groups = [{"sex": 0.0}]

def measure_dataset_fairness(data, title):
    metric = BinaryLabelDatasetMetric(
        data,
        unprivileged_groups=unprivileged_groups,
        privileged_groups=privileged_groups
    )
    print(f"\n{title}")
    print("Mean outcome, unprivileged group:",
          round(metric.base_rate(False), 4))
    print("Mean outcome, privileged group:",
          round(metric.base_rate(True), 4))
    print("Disparate impact:",
          round(metric.disparate_impact(), 4))

measure_dataset_fairness(train, "Before Reweighing")

# Apply Reweighing to the training data only
reweighing = Reweighing(
    unprivileged_groups=unprivileged_groups,
    privileged_groups=privileged_groups
)
train_reweighted = reweighing.fit_transform(train)

measure_dataset_fairness(
    train_reweighted, "After Reweighing - weighted training data"
)

# Train baseline Logistic Regression
def fit_and_evaluate(data, title):
    X_train = data.features
    y_train = data.labels.ravel()
    sample_weights = data.instance_weights

    model = make_pipeline(
        StandardScaler(),
        LogisticRegression(max_iter=1000)
    )

    model.fit(
        X_train,
        y_train,
        logisticregression__sample_weight=sample_weights
    )

    predictions = model.predict(test.features)

    predicted_dataset = test.copy()
    predicted_dataset.labels = predictions.reshape(-1, 1)

    metric = ClassificationMetric(
        test,
        predicted_dataset,
        unprivileged_groups=unprivileged_groups,
        privileged_groups=privileged_groups
    )

    print(f"\n{title}")
    print("Test accuracy:",
          round(accuracy_score(test.labels, predictions), 4))
    print("Disparate impact:",
          round(metric.disparate_impact(), 4))
    print("Statistical parity difference:",
          round(metric.statistical_parity_difference(), 4))
    print("Equal opportunity difference:",
          round(metric.equal_opportunity_difference(), 4))

    return model

baseline_model = fit_and_evaluate(train, "Baseline model")
reweighted_model = fit_and_evaluate(
    train_reweighted, "Reweighed model"
)


import shap
import matplotlib.pyplot as plt

# Explain a manageable sample of the test data.
X_explain = pd.DataFrame(
    test.features[:100],
    columns=test.feature_names
)

# Use the fitted Logistic Regression pipeline.
explainer = shap.Explainer(
    baseline_model.predict,
    X_explain
)

shap_values = explainer(X_explain)

shap.plots.bar(shap_values, max_display=15, show=False)
plt.tight_layout()
plt.savefig("W4D6_shap_summary.png", dpi=150, bbox_inches="tight")
plt.show()
