with open(pickle_path, "rb") as file:
    loaded_pickle_model = pickle.load(file)

pickle_predictions = loaded_pickle_model.predict(X_test)

print("Pickle predictions match:",
      np.array_equal(predictions, pickle_predictions))

# 9. Compare results
results = pd.DataFrame({
    "Model": ["Original", "Loaded with joblib", "Loaded with pickle"],
    "Accuracy": [
        original_accuracy,
        accuracy_score(y_test, joblib_predictions),
        accuracy_score(y_test, pickle_predictions)
    ],
    "Predictions_Match": [
        True,
        np.array_equal(predictions, joblib_predictions),
        np.array_equal(predictions, pickle_predictions)
    ]
})

results.to_csv(OUTPUT_DIR / "serialisation_results.csv", index=False)

print("\nSerialisation comparison:")
print(results.to_string(index=False))
print("\nAll output files saved in:", OUTPUT_DIR.resolve())

