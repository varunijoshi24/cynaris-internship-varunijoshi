# W2D3: Handling Imbalanced Data using SMOTE

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import make_classification
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report
from imblearn.over_sampling import SMOTE

os.makedirs("outputs", exist_ok=True)

# 1. Create an imbalanced sample dataset
X, y = make_classification(
    n_samples=1000,
    n_features=6,
    n_informative=4,
    n_redundant=0,
    weights=[0.90, 0.10],
    random_state=42
)

X = pd.DataFrame(X, columns=[f"feature_{i}" for i in range(1, 7)])
y = pd.Series(y, name="target")

print("Before SMOTE:")
print(y.value_counts())

# 2. Split data BEFORE applying SMOTE
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42
)

# 3. Scale using training data only
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# 4. Apply SMOTE only to training data
smote = SMOTE(random_state=42)
X_resampled, y_resampled = smote.fit_resample(
    X_train_scaled, y_train
)

print("\nAfter SMOTE:")
print(pd.Series(y_resampled).value_counts())

# 5. Plot class distribution
before = y_train.value_counts().sort_index()
after = pd.Series(y_resampled).value_counts().sort_index()

fig, axes = plt.subplots(1, 2, figsize=(9, 4))

before.plot(kind="bar", ax=axes[0], title="Before SMOTE")
after.plot(kind="bar", ax=axes[1], title="After SMOTE")

for ax in axes:
    ax.set_xlabel("Class")
    ax.set_ylabel("Number of samples")

plt.tight_layout()
plt.savefig("outputs/smote_class_distribution.png", dpi=300)
plt.show()

# 6. Train a model
model = LogisticRegression(max_iter=1000)
model.fit(X_resampled, y_resampled)

# 7. Evaluate on untouched test data
predictions = model.predict(X_test_scaled)

print("\nClassification Report:")
print(classification_report(y_test, predictions, zero_division=0))

# 8. Save evidence
pd.DataFrame(X_resampled, columns=X.columns).assign(
    target=np.asarray(y_resampled)
).to_csv("outputs/smote_training_data.csv", index=False)

print("\nSMOTE practical completed!")

